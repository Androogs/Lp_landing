# ============================================================
# API Licores Palmira · copia este archivo a .env y completa.
# NUNCA subas .env a Git. Genera secretos con: npm run secrets:generate
# ============================================================
NODE_ENV=development
PORT=3000
TRUST_PROXY=1
LOG_LEVEL=info

# Dominio público (en producción: https://licorespalmira.com)
PUBLIC_SITE_URL=http://127.0.0.1:5173
# Solo desarrollo: orígenes extra separados por coma. En producción debe quedar vacío.
EXTRA_ALLOWED_ORIGINS=

# Usuario de MÍNIMO PRIVILEGIO (lp_app). Las migraciones se corren con el dueño (MIGRATOR_DATABASE_URL en infra).
DATABASE_URL=postgres://lp_app:CAMBIAR@127.0.0.1:5432/licorespalmira
DATABASE_SSL=disable

# Cifrado de datos personales (AES-256-GCM, clave versionada) y demás secretos
DATA_ENCRYPTION_KEYS=v1:CAMBIAR_BASE64_32_BYTES
DATA_ENCRYPTION_ACTIVE=v1
BLIND_INDEX_KEY=CAMBIAR_BASE64_32_BYTES
PASSWORD_PEPPER=CAMBIAR_BASE64_32_BYTES
CSRF_SECRET=CAMBIAR_BASE64_32_BYTES

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Wompi: Dashboard de Comercios → Desarrolladores → Secretos para integración técnica
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_CAMBIAR
WOMPI_INTEGRITY_SECRET=test_integrity_CAMBIAR
WOMPI_EVENTS_SECRET=test_events_CAMBIAR
WOMPI_VERIFY_WITH_API=true
WOMPI_EVENT_MAX_AGE_HOURS=72

RETENTION_MONTHS=24
